<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gestion_utiles_escolares.DashboardUtilesEscolares">
        <div class="o_utiles_dashboard">

            <div class="o_utiles_toolbar">
                <div class="o_utiles_search_box">
                    <i class="fa fa-search"/>
                    <input type="text"
                           placeholder="Buscar producto, categoría..."
                           t-model="state.search"/>
                </div>

                <button type="button"
                        class="o_utiles_button"
                        t-on-click="exportCsv">
                    <i class="fa fa-download"/>
                    Exportar
                </button>
            </div>

            <div class="o_utiles_summary_grid">
                <div class="o_utiles_summary_card">
                    <span class="o_utiles_summary_number" t-esc="state.totalItems"/>
                    <span class="o_utiles_summary_label">Ítems disponibles</span>
                </div>

                <div class="o_utiles_summary_card">
                    <span class="o_utiles_summary_number" t-esc="state.totalProducts"/>
                    <span class="o_utiles_summary_label">Productos distintos</span>
                </div>

                <div class="o_utiles_summary_card">
                    <span class="o_utiles_summary_number" t-esc="state.lowStock"/>
                    <span class="o_utiles_summary_label">Stock bajo</span>
                </div>

                <div class="o_utiles_summary_card">
                    <span class="o_utiles_summary_number o_utiles_danger" t-esc="state.noStock"/>
                    <span class="o_utiles_summary_label">Sin stock</span>
                </div>
            </div>

            <div class="o_utiles_stock_panel">

                <div class="o_utiles_panel_header">
                    <div>
                        <h2>Stock en almacén general</h2>
                        <small>
                            Año actual:
                            <strong t-esc="state.currentYearLabel"/>
                            · Sobrante:
                            <strong t-esc="state.previousYearLabel"/>
                        </small>
                    </div>

                    <span>
                        Actualizado:
                        <t t-esc="state.updatedAt"/>
                    </span>
                </div>

                <!-- Filtro por categoría -->
                <div class="o_utiles_filter_group">
                    <div class="o_utiles_filter_label">
                        Categoría:
                        <strong t-esc="state.selectedCategory"/>
                    </div>

                    <div class="o_utiles_categories">
                        <t t-foreach="state.categories"
                           t-as="category"
                           t-key="category">
                            <button type="button"
                                    t-att-class="category === state.selectedCategory ? 'o_utiles_chip active' : 'o_utiles_chip'"
                                    t-on-click="() => this.selectCategory(category)">
                                <t t-esc="category"/>
                            </button>
                        </t>
                    </div>
                </div>

                <!-- Filtro por nivel y grado -->
                <div class="o_utiles_filter_group">
                    <div class="o_utiles_filter_label">
                        Nivel / grado:
                        <strong t-esc="selectedGradeLabel"/>
                    </div>

                    <div class="o_utiles_categories o_utiles_grades">
                        <button type="button"
                                t-att-class="state.selectedGrade === 'Todos' &amp;&amp; !state.selectedNivel ? 'o_utiles_chip active' : 'o_utiles_chip'"
                                t-on-click="() => this.selectGrade('Todos')">
                            Todos los grados
                        </button>

                        <button type="button"
                                t-att-class="state.showGradeGroup === 'Inicial' || state.selectedNivel === 'Inicial' ? 'o_utiles_chip active' : 'o_utiles_chip'"
                                t-on-click="() => this.toggleGradeGroup('Inicial')">
                            Inicial ▾
                        </button>

                        <button type="button"
                                t-att-class="state.showGradeGroup === 'Primaria' || state.selectedNivel === 'Primaria' ? 'o_utiles_chip active' : 'o_utiles_chip'"
                                t-on-click="() => this.toggleGradeGroup('Primaria')">
                            Primaria ▾
                        </button>
                    </div>

                    <div class="o_utiles_subgrades"
                         t-if="state.showGradeGroup === 'Inicial'">
                        <t t-foreach="inicialGrades"
                           t-as="grade"
                           t-key="grade.value">
                            <button type="button"
                                    t-att-class="grade.value === state.selectedGrade ? 'o_utiles_chip active' : 'o_utiles_chip'"
                                    t-on-click="() => this.setGradeFilter(grade.value)">
                                <t t-esc="grade.label"/>
                            </button>
                        </t>
                    </div>

                    <div class="o_utiles_subgrades"
                         t-if="state.showGradeGroup === 'Primaria'">
                        <t t-foreach="primariaGrades"
                           t-as="grade"
                           t-key="grade.value">
                            <button type="button"
                                    t-att-class="grade.value === state.selectedGrade ? 'o_utiles_chip active' : 'o_utiles_chip'"
                                    t-on-click="() => this.setGradeFilter(grade.value)">
                                <t t-esc="grade.label"/>
                            </button>
                        </t>
                    </div>
                </div>

                <div class="o_utiles_table_wrap">
                    <table class="o_utiles_table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th>
                                    Año actual
                                    <t t-esc="state.currentYearLabel"/>
                                </th>
                                <th>
                                    Sobrante
                                    <t t-esc="state.previousYearLabel"/>
                                </th>
                                <th>Total disponible</th>
                                <th>Retirado</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-if="filteredProducts.length">
                                <tr t-foreach="filteredProducts"
                                    t-as="product"
                                    t-key="product.id">

                                    <td class="o_utiles_product_name">
                                        <span class="o_utiles_product_icon">✎</span>
                                        <div>
                                            <strong t-esc="product.name"/>
                                            <small t-if="product.code" t-esc="product.code"/>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="o_utiles_category_badge"
                                              t-esc="product.category"/>
                                    </td>

                                    <td t-esc="product.currentQty"/>
                                    <td t-esc="product.previousQty"/>

                                    <td>
                                        <div class="o_utiles_availability">
                                            <span class="o_utiles_bar">
                                                <span t-att-style="progressWidth(product)"/>
                                            </span>
                                            <strong t-esc="product.totalQty"/>
                                        </div>
                                    </td>

                                    <td t-esc="product.reserved"/>

                                    <td>
                                        <span t-att-class="'o_utiles_status ' + statusClass(product.status)"
                                              t-esc="product.status"/>
                                    </td>
                                </tr>
                            </t>

                            <tr t-else="">
                                <td colspan="7" class="o_utiles_empty">
                                    No hay productos para mostrar.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
    </t>

</templates>