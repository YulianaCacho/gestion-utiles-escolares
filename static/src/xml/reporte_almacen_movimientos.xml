<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gestion_utiles_escolares.ReporteAlmacenMovimientos">
        <div class="o_ram_page o_reporte_utiles_scroll">
            <div class="o_ram_body">

                <!-- FILTROS -->
                <div class="o_ram_toolbar">
                    <div class="o_ram_month_box">
                        <i class="fa fa-calendar"/>
                        <input type="month" t-att-value="state.selectedMonth" t-on-change="onChangeMonth"/>
                    </div>

                    <div class="o_ram_select_box">
                        <i class="fa fa-filter"/>
                        <select t-on-change="onChangeGrado">
                            <option value="">Por grado</option>
                            <t t-foreach="state.grados" t-as="grado" t-key="grado.value">
                                <option t-att-value="grado.value" t-att-selected="state.gradoSeleccionado === grado.value ? true : undefined">
                                    <t t-esc="grado.label"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="o_ram_select_box">
                        <i class="fa fa-user-o"/>
                        <select t-on-change="onChangeResponsable">
                            <option value="">Por responsable</option>
                            <t t-foreach="state.responsables" t-as="responsable" t-key="responsable.id">
                                <option t-att-value="responsable.id" t-att-selected="state.responsableSeleccionado == responsable.id ? true : undefined">
                                    <t t-esc="responsable.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="o_ram_select_box">
                        <i class="fa fa-cube"/>
                        <select t-on-change="onChangeProducto">
                            <option value="">Por producto</option>
                            <t t-foreach="state.productos" t-as="producto" t-key="producto.id">
                                <option t-att-value="producto.id"
                                        t-att-selected="state.productoSeleccionado == producto.id ? true : undefined">
                                    <t t-esc="producto.name"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="o_ram_spacer"></div>

                    <button type="button" class="o_ram_btn o_ram_btn_pdf" t-on-click="exportPdf">
                        <i class="fa fa-download"/>
                        Exportar PDF
                    </button>
                </div>

                                <!-- BLOQUE RESUMEN SUPERIOR -->
                <div class="o_ram_resumen_superior">

                    <div class="o_ram_resumen_toolbar">
                        <div class="o_ram_resumen_filter">
                            <i class="fa fa-calendar"/>
                            <span t-esc="state.monthLabel"/>
                        </div>

                        <div class="o_ram_resumen_filter">
                            <i class="fa fa-filter"/>
                            <span>Por grado</span>
                        </div>

                        <div class="o_ram_resumen_filter">
                            <i class="fa fa-user-o"/>
                            <span>Por responsable</span>
                        </div>

                        <div class="o_ram_resumen_spacer"></div>

                        <button type="button" class="o_ram_resumen_export" t-on-click="exportPdf">
                            <i class="fa fa-download"/>
            Exportar PDF
                        </button>
                    </div>

                    <div class="o_ram_resumen_kpis">
                        <div class="o_ram_resumen_card">
                            <div class="o_ram_resumen_label">
                                <span>↧</span>
                Entradas este mes
                            </div>
                            <strong class="o_ram_resumen_green" t-esc="state.kpis.entradas"/>
                        </div>

                        <div class="o_ram_resumen_card">
                            <div class="o_ram_resumen_label">
                                <span>↥</span>
                Salidas este mes
                            </div>
                            <strong class="o_ram_resumen_red" t-esc="state.kpis.salidas"/>
                        </div>

                        <div class="o_ram_resumen_card">
                            <div class="o_ram_resumen_label">
                                <span>⚙</span>
                Ajustes realizados
                            </div>
                            <strong class="o_ram_resumen_blue" t-esc="state.kpis.ajustes"/>
                        </div>

                        <div class="o_ram_resumen_card">
                            <div class="o_ram_resumen_label">
                                <span>⚖</span>
                Balance neto
                            </div>
                            <strong t-esc="state.kpis.balance"/>
                        </div>
                    </div>

                </div>

                <!-- TARJETAS RESUMEN -->
                <div class="o_ram_kpis">
                    <div class="o_ram_card">
                        <div class="o_ram_card_label">
                            <span>↧</span>
                            Entradas este mes
                        </div>
                        <strong class="o_ram_green" t-esc="state.kpis.entradas"/>
                    </div>

                    <div class="o_ram_card">
                        <div class="o_ram_card_label">
                            <span>↥</span>
                            Salidas este mes
                        </div>
                        <strong class="o_ram_red" t-esc="state.kpis.salidas"/>
                    </div>

                    <div class="o_ram_card">
                        <div class="o_ram_card_label">
                            <span>⚙</span>
                            Ajustes realizados
                        </div>
                        <strong class="o_ram_blue" t-esc="state.kpis.ajustes"/>
                    </div>

                    <div class="o_ram_card">
                        <div class="o_ram_card_label">
                            <span>⚖</span>
                            Balance neto
                        </div>
                        <strong t-esc="state.kpis.balance"/>
                    </div>
                </div>

                <!-- TABLA MODERNA -->
                <div class="o_ram_table_card">
                    <table class="o_ram_table">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Motivo</th>
                                <th>Producto</th>
                                <th>Grado</th>
                                <th>Cant.</th>
                                <th>Unidad</th>
                                <th>Destino</th>
                                <th>Responsable</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-if="state.events.length">
                                <tr t-foreach="state.events" t-as="event" t-key="event.id">
                                    <td class="o_ram_fecha">
                                        <div t-esc="event.fecha"/>
                                        <small t-esc="event.hora"/>
                                    </td>

                                    <td>
                                        <span t-att-class="'o_ram_tipo_badge o_ram_tipo_' + event.tipo_class">
                                            <t t-esc="event.tipo_icon"/>
                                            <t t-esc="event.tipo_label"/>
                                        </span>
                                    </td>

                                    <td class="o_ram_motivo" t-att-title="event.motivo">
                                        <t t-esc="event.motivo"/>
                                    </td>

                                    <td class="o_ram_producto" t-att-title="event.producto">
                                        <t t-esc="event.producto"/>
                                    </td>

                                    <td>
                                        <span class="o_ram_grado_badge" t-esc="event.grado_label"/>
                                    </td>

                                    <td class="o_ram_cantidad" t-esc="event.cantidad"/>
                                    <td class="o_ram_unidad" t-esc="event.unidad"/>

                                    <td class="o_ram_destino" t-att-title="event.destino">
                                        <i class="fa fa-home"/>
                                        <span t-esc="event.destino"/>
                                    </td>

                                    <td class="o_ram_responsable" t-att-title="event.responsable">
                                        <span class="o_ram_avatar" t-esc="event.responsable_iniciales"/>
                                        <span class="o_ram_responsable_text" t-esc="event.responsable"/>
                                    </td>
                                </tr>
                            </t>

                            <tr t-else="">
                                <td colspan="9" class="o_ram_empty">
                                    Todavía no hay movimientos registrados para este mes.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </t>

</templates>