<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gestion_utiles_escolares.ReporteAlmacenMovimientos">
        <div class="o_ram_page">

            <div class="o_ram_header">
                <strong>
                    <i class="fa fa-clipboard"/>
                    Reportes
                </strong>
                <span>/ Almacén y movimientos</span>
            </div>

            <div class="o_ram_body">

                <div class="o_ram_toolbar">
                    <button type="button" class="o_ram_btn">
                        <i class="fa fa-calendar-o"/>
                        <t t-esc="state.monthLabel"/>
                    </button>

                    <button type="button" class="o_ram_btn">
                        <i class="fa fa-filter"/>
                        Por grado
                    </button>

                    <button type="button" class="o_ram_btn">
                        <i class="fa fa-user-o"/>
                        Por responsable
                    </button>

                    <div></div>

                    <button type="button" class="o_ram_btn o_ram_btn_pdf" t-on-click="exportPdf">
                        <i class="fa fa-download"/>
                        Exportar PDF
                    </button>
                </div>

                <div class="o_ram_kpis">
                    <div class="o_ram_card">
                        <strong t-esc="state.kpis.entradas"/>
                        <span>Entradas este mes</span>
                    </div>

                    <div class="o_ram_card">
                        <strong t-esc="state.kpis.salidas"/>
                        <span>Salidas este mes</span>
                    </div>

                    <div class="o_ram_card">
                        <strong t-esc="state.kpis.ajustes"/>
                        <span>Ajustes realizados</span>
                    </div>

                    <div class="o_ram_card">
                        <strong t-esc="state.kpis.balance"/>
                        <span>Balance neto</span>
                    </div>
                </div>

                <div class="o_ram_info">
                    <i class="fa fa-info-circle"/>
                    <span>
                        Este reporte combina entradas por matrícula, salidas a docentes y ajustes de inventario
                        en una sola vista. Pensado para que la directora vea el movimiento completo del mes de un vistazo.
                    </span>
                </div>

                <h3 class="o_ram_title">
                    LÍNEA DE TIEMPO — <t t-esc="state.monthShort"/>
                </h3>

                <div class="o_ram_timeline">
                    <t t-if="state.events.length">
                        <div t-foreach="state.events" t-as="event" t-key="event.id" class="o_ram_event">
                            <span t-att-class="'o_ram_dot o_ram_dot_' + event.tipo"/>

                            <div class="o_ram_event_content">
                                <div class="o_ram_event_top">
                                    <strong t-esc="event.titulo"/>
                                    <span t-att-class="'o_ram_badge ' + event.badge_class" t-esc="event.badge"/>
                                    <small>
                                        <t t-esc="event.fecha"/> · <t t-esc="event.responsable"/>
                                    </small>
                                </div>

                                <p t-esc="event.detalle"/>
                            </div>
                        </div>
                    </t>

                    <div t-else="" class="o_ram_empty">
                        Todavía no hay movimientos registrados para este mes.
                        Cuando valides recepciones o entregas, aparecerán aquí automáticamente.
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>