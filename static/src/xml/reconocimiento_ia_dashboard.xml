<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gestion_utiles_escolares.ReconocimientoIADashboard">
        <div class="o_ia_utiles_dashboard">

            <!-- ENCABEZADO -->
            <div class="o_ia_utiles_hero">
                <div>
                    <span class="o_ia_utiles_badge">Modelo YOLO entrenado</span>
                    <h1>Reconocimiento IA de útiles escolares</h1>
                    <p>
                        Sube una imagen del útil escolar y el sistema intentará reconocer el producto usando tu modelo entrenado.
                    </p>
                </div>

                <div class="o_ia_utiles_status_card">
                    <div class="o_ia_utiles_status_title">
                        Estado del modelo
                    </div>

                    <div t-if="state.checkingModel" class="o_ia_utiles_status_wait">
                        Verificando modelo...
                    </div>

                    <div t-if="!state.checkingModel">
                        <div t-if="modelReady" class="o_ia_utiles_status_ok">
                            Disponible
                        </div>

                        <div t-if="!modelReady" class="o_ia_utiles_status_bad">
                            Pendiente
                        </div>

                        <small>
                            Peso:
                            <strong t-esc="state.modelStatus.size_mb"/>
                            MB
                        </small>

                        <small>
                            <t t-esc="state.modelStatus.dependency_message"/>
                        </small>
                    </div>
                </div>
            </div>

            <!-- CONTENIDO PRINCIPAL -->
            <div class="o_ia_utiles_grid">

                <!-- PANEL IZQUIERDO: IMAGEN -->
                <div class="o_ia_utiles_upload_panel">
                    <div class="o_ia_utiles_panel_header">
                        <div>
                            <h2>Imagen para analizar</h2>
                            <p>Selecciona una foto tomada desde celular o cargada desde tu computadora.</p>
                        </div>
                    </div>

                    <label class="o_ia_utiles_dropzone">
                        <input type="file" accept="image/*" t-on-change="onFileChange"/>

                        <div t-if="!state.preview" class="o_ia_utiles_drop_content">
                            <i class="fa fa-cloud-upload"/>
                            <strong>Seleccionar imagen</strong>
                            <span>JPG, PNG o JPEG</span>
                        </div>

                        <img t-if="state.preview"
                             t-att-src="state.preview"
                             class="o_ia_utiles_preview"/>
                    </label>

                    <div t-if="state.filename" class="o_ia_utiles_filename">
                        Archivo:
                        <strong t-esc="state.filename"/>
                    </div>

                    <div class="o_ia_utiles_actions">
                        <button type="button"
                                class="o_ia_utiles_btn primary"
                                t-on-click="analyzeImage"
                                t-att-disabled="state.loading">
                            <i class="fa fa-magic"/>
                            <span t-if="!state.loading">Analizar imagen</span>
                            <span t-if="state.loading">Analizando...</span>
                        </button>

                        <button t-if="state.recepcionId &amp;&amp; state.detections.length"
                                type="button"
                                class="o_ia_utiles_btn primary"
                                t-on-click="applyToReception"
                                t-att-disabled="state.applyLoading">
                            <i class="fa fa-check"/>
                            <span t-if="!state.applyLoading">Marcar en recepción</span>
                            <span t-if="state.applyLoading">Marcando...</span>
                        </button>

                        <button type="button"
                                class="o_ia_utiles_btn secondary"
                                t-on-click="clearImage">
                            Limpiar
                        </button>
                    </div>

                    <div t-if="state.error" class="o_ia_utiles_error">
                        <strong>Error:</strong>
                        <t t-esc="state.error"/>
                    </div>
                </div>

                <!-- PANEL DERECHO: RESULTADOS -->
                <div class="o_ia_utiles_result_panel">
                    <div class="o_ia_utiles_panel_header">
                        <div>
                            <h2>Resultado del reconocimiento</h2>
                            <p>El sistema mostrará la clase detectada, confianza y coincidencia con producto de Odoo.</p>
                        </div>
                    </div>

                    <!-- SIN RESULTADO -->
                    <div t-if="!state.result" class="o_ia_utiles_empty_result">
                        <i class="fa fa-search"/>
                        <h3>Aún no hay análisis</h3>
                        <p>Selecciona una imagen y presiona “Analizar imagen”.</p>
                    </div>

                    <!-- CON RESULTADO -->
                    <div t-if="state.result">

                        <!-- MEJOR RESULTADO -->
                        <div t-if="topDetection" class="o_ia_utiles_best_result">
                            <span>Producto más probable</span>
                            <h3 t-esc="topDetection.label"/>

                            <div class="o_ia_utiles_confidence">
                                Confianza:
                                <strong t-esc="confidenceText"/>
                            </div>

                            <div t-if="topDetection.product_name" class="o_ia_utiles_product_match">
                                Coincide con Odoo:
                                <strong t-esc="topDetection.product_name"/>
                            </div>

                            <div t-if="!topDetection.product_name" class="o_ia_utiles_product_nomatch">
                                No se encontró coincidencia exacta con productos de Odoo.
                            </div>
                        </div>

                        <!-- NO DETECTÓ -->
                        <div t-if="!topDetection" class="o_ia_utiles_empty_result">
                            <i class="fa fa-exclamation-circle"/>
                            <h3>No se detectaron productos</h3>
                            <p>Prueba con una imagen más clara o con el útil más cerca.</p>
                        </div>

                        <!-- TABLA DE DETECCIONES -->
                        <div t-if="state.detections.length" class="o_ia_utiles_table_wrap">
                            <table class="o_ia_utiles_table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Clase detectada</th>
                                        <th>Confianza</th>
                                        <th>Producto en Odoo</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-foreach="state.detections"
                                       t-as="detection"
                                       t-key="detection_index">
                                        <tr>
                                            <td t-esc="detection_index + 1"/>

                                            <td>
                                                <strong t-esc="detection.label"/>
                                            </td>

                                            <td>
                                                <t t-esc="detection.confidence"/>
                                                %
                                            </td>

                                            <td>
                                                <span t-if="detection.product_name"
                                                      t-esc="detection.product_name"/>

                                                <span t-if="!detection.product_name"
                                                      class="o_ia_utiles_muted">
                                                    Sin coincidencia
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- RESULTADO APLICADO A RECEPCIÓN -->
                        <div t-if="state.applyResult" class="o_ia_utiles_apply_result">
                            <h3>Resultado aplicado a recepción</h3>

                            <div t-if="state.applyResult.aplicadas.length">
                                <strong>Productos marcados:</strong>
                                <ul>
                                    <t t-foreach="state.applyResult.aplicadas"
                                       t-as="item"
                                       t-key="item.linea_id">
                                        <li>
                                            <t t-esc="item.producto"/>
                                            —
                                            Entregado:
                                            <t t-esc="item.cantidad_entregada"/>
                                            /
                                            <t t-esc="item.cantidad_esperada"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <div t-if="state.applyResult.no_encontradas.length">
                                <strong>No encontrados en la lista:</strong>
                                <ul>
                                    <t t-foreach="state.applyResult.no_encontradas"
                                       t-as="item"
                                       t-key="item.label">
                                        <li>
                                            <t t-esc="item.label"/>
                                            —
                                            <t t-esc="item.motivo"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <div t-if="state.applyResult.ya_completas.length">
                                <strong>Ya estaban completos:</strong>
                                <ul>
                                    <t t-foreach="state.applyResult.ya_completas"
                                       t-as="item"
                                       t-key="item.label">
                                        <li>
                                            <t t-esc="item.label"/>
                                            —
                                            <t t-esc="item.motivo"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- NOTA -->
            <div class="o_ia_utiles_note">
                <strong>Nota:</strong>
                este apartado usa tu modelo entrenado de 30 clases. Para marcar útiles en la lista del alumno,
                abre este panel desde una recepción y usa el botón “Marcar en recepción”.
            </div>

        </div>
    </t>

</templates>