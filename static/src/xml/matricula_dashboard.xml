<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gestion_utiles_escolares.MatriculaDashboard">
        <div class="o_matricula_dashboard_full">

            <!-- CABECERA -->
            <div class="o_matricula_dashboard_header">
                <div class="o_matricula_title_block">
                    <div class="o_matricula_title_icon">
                        <i class="fa fa-id-card-o" title="Lista de matrícula"/>
                    </div>

                    <div>
                        <h2 t-esc="state.titulo"/>
                        <div class="o_matricula_subtitle" t-esc="state.subtitulo"/>
                    </div>
                </div>

                <div class="o_matricula_header_actions">

                    <button type="button"
                            class="o_md_btn o_md_btn_light"
                            title="Gestionar registros"
                            t-on-click="() => this.openManageRecords()">
                        <i class="fa fa-database" title="Gestionar registros"/>
                    </button>

                    <div class="o_md_config_dropdown">
                        <button type="button"
                                class="o_md_btn o_md_btn_light"
                                title="Configuración"
                                t-on-click="(ev) => this.toggleConfigMenu(ev)">
                            <i class="fa fa-cog" title="Configuración"/>
                        </button>

                        <div t-if="state.showConfigMenu" class="o_md_config_menu">
                            <button type="button"
                                    class="o_md_config_item"
                                    t-on-click="(ev) => this.importarRegistros(ev)">
                                <i class="fa fa-download" title="Importar registros"/>
                                <span>Importar registros</span>
                            </button>

                            <button type="button"
                                    class="o_md_config_item"
                                    t-on-click="(ev) => this.exportarTodo(ev)">
                                <i class="fa fa-upload" title="Exportar todo"/>
                                <span>Exportar todo</span>
                            </button>
                        </div>
                    </div>

                    <button type="button"
                            class="o_md_btn o_md_btn_primary"
                            title="Nueva matrícula"
                            t-on-click="() => this.openNew()">
                        <i class="fa fa-plus" title="Nueva matrícula"/>
                        <span>Nuevo</span>
                    </button>

                </div>
            </div>

            <!-- ESTADÍSTICAS -->
            <div class="o_matricula_stats_grid">
                <div class="o_md_stat_card">
                    <div class="o_md_stat_icon green">
                        <i class="fa fa-users" title="Total estudiantes"/>
                    </div>

                    <div>
                        <div class="o_md_stat_label">Total estudiantes</div>
                        <div class="o_md_stat_value" t-esc="state.stats.total_estudiantes"/>
                    </div>
                </div>

                <div class="o_md_stat_card">
                    <div class="o_md_stat_icon blue">
                        <i class="fa fa-graduation-cap" title="Grados activos"/>
                    </div>

                    <div>
                        <div class="o_md_stat_label">Grados activos</div>
                        <div class="o_md_stat_value" t-esc="state.stats.grados_activos"/>
                    </div>
                </div>

                <div class="o_md_stat_card">
                    <div class="o_md_stat_icon orange">
                        <i class="fa fa-check-circle-o" title="Matrículas activas"/>
                    </div>

                    <div>
                        <div class="o_md_stat_label">Matrículas activas</div>
                        <div class="o_md_stat_value" t-esc="state.stats.matriculas_activas"/>
                    </div>
                </div>
            </div>

            <!-- TABLA -->
            <div class="o_md_table_card">
                <div class="o_md_table_toolbar">
                    <div class="o_md_search_box">
                        <i class="fa fa-search" title="Buscar"/>
                        <input type="text"
                               placeholder="Buscar estudiante..."
                               t-att-value="state.search"
                               t-on-input="(ev) => this.onSearchInput(ev)"
                               t-on-keydown="(ev) => this.onSearchKeydown(ev)"/>

                        <button type="button"
                                class="o_md_filter_btn"
                                title="Buscar"
                                t-on-click="() => this.doSearch()">
                            <i class="fa fa-filter" title="Buscar"/>
                        </button>
                    </div>

                    <div class="o_md_pager">
                        <span t-esc="state.rows.length + ' registros'"/>
                    </div>
                </div>

                <div class="o_md_table_wrap">
                    <table class="o_md_table">
                        <thead>
                            <tr>
                                <th style="width: 36px;"></th>
                                <th>Estudiante</th>
                                <th>Grado escolar</th>
                                <th>Apoderado principal</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-if="state.rows.length">
                                <tr t-foreach="state.rows"
                                    t-as="row"
                                    t-key="row.id"
                                    t-on-click="() => this.openForm(row.id)">

                                    <td>
                                        <input type="checkbox"
                                               t-on-click.stop="() => {}"/>
                                    </td>

                                    <td>
                                        <div class="o_md_student_cell">
                                            <div class="o_md_avatar" t-esc="row.iniciales"/>
                                            <div class="o_md_student_name" t-esc="row.estudiante"/>
                                        </div>
                                    </td>

                                    <td>
                                        <span t-att-class="'o_md_grado_badge ' + row.grado_class"
                                              t-esc="row.grado"/>
                                    </td>

                                    <td class="o_md_guardian_cell" t-esc="row.apoderado_principal"/>

                                    <td class="o_md_more_cell">
                                        <button type="button"
                                                class="o_md_more_btn"
                                                title="Editar matrícula"
                                                t-on-click.stop="() => this.openForm(row.id)">
                                            <i class="fa fa-ellipsis-h" title="Editar matrícula"/>
                                        </button>
                                    </td>
                                </tr>
                            </t>

                            <tr t-else="">
                                <td colspan="5" class="o_md_empty">
                                    No hay matrículas registradas.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </t>

</templates>