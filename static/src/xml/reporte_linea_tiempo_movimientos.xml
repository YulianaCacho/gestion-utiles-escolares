<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gestion_utiles_escolares.ReporteLineaTiempoMovimientos">
        <div class="o_ltm_page o_reporte_utiles_scroll">

            <div class="o_ltm_toolbar">
                <div class="o_ltm_search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Buscar producto, responsable..." t-att-value="state.search" t-on-input="onInputSearch"/>
                </div>

                <div class="o_ltm_month">
                    <i class="fa fa-calendar"/>
                    <input type="month" t-att-value="state.selectedMonth" t-on-change="onChangeMonth"/>
                </div>

                <div class="o_ltm_type">
                    <i class="fa fa-filter"/>
                    <select t-on-change="onChangeTipo">
                        <option value="">Tipo</option>
                        <option value="entrada" t-att-selected="state.tipoSeleccionado === 'entrada' ? true : undefined">Entrada</option>
                        <option value="salida" t-att-selected="state.tipoSeleccionado === 'salida' ? true : undefined">Salida</option>
                        <option value="ajuste" t-att-selected="state.tipoSeleccionado === 'ajuste' ? true : undefined">Ajuste</option>
                    </select>
                </div>

                <button type="button" class="o_ltm_export" t-on-click="exportPdf">
                    <i class="fa fa-download"/>
                    Exportar
                </button>
            </div>

            <div class="o_ltm_header">
                <h2>Todos los movimientos</h2>
                <span>
                    <t t-esc="state.total"/>
 movimientos · <t t-esc="state.monthLabel"/>
                </span>
            </div>

            <div class="o_ltm_chips">
                <button type="button" t-att-class="state.tipoSeleccionado === '' ? 'active' : ''" t-on-click="clearTipo">
                    Todos
                </button>

                <button type="button" t-att-class="state.tipoSeleccionado === 'entrada' ? 'active entrada' : 'entrada'" t-on-click="() => this.setTipo('entrada')">
                    <span class="dot entrada"></span>
                    Entradas
                </button>

                <button type="button" t-att-class="state.tipoSeleccionado === 'salida' ? 'active salida' : 'salida'" t-on-click="() => this.setTipo('salida')">
                    <span class="dot salida"></span>
                    Salidas
                </button>

                <button type="button" t-att-class="state.tipoSeleccionado === 'ajuste' ? 'active ajuste' : 'ajuste'" t-on-click="() => this.setTipo('ajuste')">
                    <span class="dot ajuste"></span>
                    Ajustes
                </button>
            </div>

            <table class="o_ltm_table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Tipo</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Responsable</th>
                        <th>Motivo / referencia</th>
                        <th>Detalle</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-if="state.rows.length">
                        <tr t-foreach="state.rows" t-as="row" t-key="row.id">
                            <td t-esc="row.fecha"/>
                            <td t-esc="row.hora"/>

                            <td>
                                <span t-att-class="'o_ltm_motivo_badge ' + row.motivo_class">
                                    <t t-esc="row.motivo"/>
                                </span>
                                <div class="o_ltm_obs" t-if="row.observacion" t-esc="row.observacion"/>
                            </td>

                            <td>
                                <div class="o_ltm_detalle" t-esc="row.detalle || 'Sin detalle adicional'"/>
                            </td>

                            <td t-esc="row.producto"/>

                            <td>
                                <strong t-att-class="'o_ltm_qty ' + row.cantidad_class" t-esc="row.cantidad"/>
                            </td>

                            <td>
                                <div class="o_ltm_user">
                                    <span class="avatar" t-esc="row.responsable_iniciales"/>
                                    <strong t-esc="row.responsable"/>
                                </div>
                            </td>
                        </tr>
                    </t>

                    <tr t-else="">
                        <td colspan="8" class="o_ltm_empty">
                            Todavía no hay movimientos registrados para este mes.
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </t>

</templates>