<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_linea_tiempo_movimientos" model="ir.actions.report">
        <field name="name">Línea de tiempo de movimientos</field>
        <field name="model">almacen.utiles.movimiento</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_utiles_escolares.report_linea_tiempo_document</field>
        <field name="report_file">gestion_utiles_escolares.report_linea_tiempo_document</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_linea_tiempo_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">

                    <h2 style="text-align:center;">Línea de tiempo de movimientos</h2>

                    <p>
                        <strong>Institución:</strong> I.E.P. Genios del Millennium
                    </p>

                    <p>
                        <strong>Total de movimientos:</strong>
                        <span t-esc="len(docs)"/>
                    </p>

                    <table class="table table-sm" style="width:100%; border-collapse:collapse; font-size:11px;">
                        <thead>
                            <tr>
                                <th style="border:1px solid #000; padding:4px;">Fecha</th>
                                <th style="border:1px solid #000; padding:4px;">Hora</th>
                                <th style="border:1px solid #000; padding:4px;">Tipo</th>
                                <th style="border:1px solid #000; padding:4px;">Producto</th>
                                <th style="border:1px solid #000; padding:4px; text-align:center;">Cantidad</th>
                                <th style="border:1px solid #000; padding:4px;">Responsable</th>
                                <th style="border:1px solid #000; padding:4px;">Motivo / referencia</th>
                                <th style="border:1px solid #000; padding:4px;">Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-esc="doc.fecha.strftime('%d/%m/%Y') if doc.fecha else ''"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-esc="doc.fecha.strftime('%H:%M') if doc.fecha else ''"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-field="doc.tipo_movimiento"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-esc="doc.product_id.display_name or ''"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px; text-align:center;">
                                    <t t-if="doc.tipo_movimiento == 'salida'">
                                        <span t-esc="'−' + str(int(doc.cantidad) if doc.cantidad == int(doc.cantidad) else round(doc.cantidad, 2))"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="'+' + str(int(doc.cantidad) if doc.cantidad == int(doc.cantidad) else round(doc.cantidad, 2))"/>
                                    </t>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <span t-esc="doc.responsable_id.name or ''"/>
                                </td>
                                <td style="border:1px solid #000; padding:4px;">
                                    <t t-if="doc.tipo_movimiento == 'entrada' and doc.recepcion_id">
                                        <t t-set="tipo_e" t-value="doc.recepcion_id.tipo_entrada or 'recepcion_utiles'"/>
                                        <t t-if="tipo_e == 'compra_directa'">Compra directa</t>
                                        <t t-elif="tipo_e == 'traslado_interno'">Traslado interno</t>
                                        <t t-elif="tipo_e == 'otro'"><span t-esc="doc.observacion or 'Otro ingreso'"/></t>
                                        <t t-else="">Recep. matrícula — <span t-esc="doc.estudiante_id.name or 'Estudiante'"/></t>
                                    </t>
                                    <t t-elif="doc.tipo_movimiento == 'salida'">
                                        <span t-esc="doc.destino or doc.observacion or 'Entrega docente'"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="doc.observacion or 'Ajuste inventario físico'"/>
                                    </t>
                                </td>
                                <td style="border:1px solid #000; padding:4px; font-size:10px;">
                                    <t t-if="doc.estudiante_id">
                                        Estudiante: <span t-esc="doc.estudiante_id.name"/><br/>
                                    </t>
                                    <t t-if="doc.grado_escolar">
                                        Grado: <span t-field="doc.grado_escolar"/><br/>
                                    </t>
                                    <t t-if="doc.destino">
                                        Destino: <span t-esc="doc.destino"/><br/>
                                    </t>
                                    <t t-if="doc.recepcion_id">
                                        Recepción: <span t-esc="doc.recepcion_id.name"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

</odoo>