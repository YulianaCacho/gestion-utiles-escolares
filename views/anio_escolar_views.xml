<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_anio_escolar_list" model="ir.ui.view">
        <field name="name">anio.escolar.list</field>
        <field name="model">anio.escolar</field>
        <field name="arch" type="xml">
            <list string="Años escolares">
                <field name="name"/>
                <field name="anio_visual" string="Año"/>
                <field name="anio_anterior_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="es_anio_prueba" string="Año de prueba" />
                <field name="estado"/>
                <field name="es_anio_prueba" string="Año de prueba" optional="show" />
                <field name="total_matriculas"/>
                <field name="total_listas"/>
                <field name="total_movimientos"/>
            </list>
        </field>
    </record>

    <record id="view_anio_escolar_form" model="ir.ui.view">
        <field name="name">anio.escolar.form</field>
        <field name="model">anio.escolar</field>
        <field name="arch" type="xml">
            <form string="Año escolar">
                <header>
                    <button name="action_activar" type="object" string="Activar año" class="btn-primary" invisible="
                            not id
                            or
                            estado != 'borrador'
                        " />

                    <button name="action_vincular_datos_existentes" type="object" string="Vincular datos existentes" class="btn-secondary" invisible="not id"/>

                    <button name="action_copiar_listas_desde_anio_anterior" type="object" string="Copiar listas del año anterior" class="btn-secondary" invisible="not id"/>

                    <button name="action_generar_matriculas_desde_anio_anterior" type="object" string="Generar matrículas desde año anterior" class="btn-secondary" invisible="not id"/>

                    <button name="action_crear_revision_matriculas" type="object" string="Iniciar revisión de promoción" class="btn-primary" invisible="not id or estado == 'cerrado'" confirm="Se creará la revisión de promoción de alumnos para este año escolar. ¿Deseas continuar?"/>

                    <button name="action_crear_revision_cierre_utiles" type="object" string="Cierre de año" class="btn-primary" invisible="not id or estado == 'cerrado'" confirm="Se creará la revisión de cierre de útiles para este año escolar. ¿Deseas continuar?"/>

                    <button
                        name="action_restaurar_y_eliminar_anio_prueba"
                        type="object"
                        string="Restablecer y eliminar año de prueba"
                        class="btn-danger"
                        invisible="
                            not id
                            or
                            not es_anio_prueba
                            "
                            confirm="Esta acción eliminará todos los datos generados en el año de prueba y restaurará el año anterior como único año activo. Las matrículas finalizadas volverán a estado Activo. ¿Deseas continuar?"
                    />

                    <field name="estado" widget="statusbar" statusbar_visible="borrador,activo,cerrado"/>
                </header>

                <sheet>
                    <group string="Datos del año escolar">
                        <group>
                            <field name="anio" invisible="id"/>
                            <field name="anio_visual" string="Año" readonly="1" invisible="not id"/>
                            <field name="anio_anterior_id" readonly="1" />
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>

                    <group string="Observación">
                        <field name="observacion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_anio_escolar" model="ir.actions.act_window">
        <field name="name">Años escolares</field>
        <field name="res_model">anio.escolar</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>