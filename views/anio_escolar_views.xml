<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_anio_escolar_list" model="ir.ui.view">
        <field name="name">anio.escolar.list</field>
        <field name="model">anio.escolar</field>
        <field name="arch" type="xml">
            <list string="Años escolares">
                <field name="name"/>
                <field name="anio"/>
                <field name="anio_anterior_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
                <field name="total_matriculas"/>
                <field name="total_listas"/>
                <field name="total_movimientos"/>
            </list>
        </field>
    </record>

    <record id="view_anio_escolar_form" model="ir.ui.view">
        <field name="name">anio.escolar.form</field>
        <field name="model">anio.escolar</field>
        <field name="arch" type="xml">
            <form string="Año escolar">
                <header>
                    <button name="action_activar"
                            type="object"
                            string="Activar año"
                            class="btn-primary"
                            invisible="estado == 'activo'"/>

                     <button name="action_vincular_datos_existentes"
                             type="object"
                             string="Vincular datos existentes"
                             class="btn-secondary"/>
                    
                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="borrador,activo,cerrado"/>
                </header>

                <sheet>
                    <group string="Datos del año escolar">
                        <group>
                            <field name="anio"/>
                            <field name="anio_anterior_id"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>

                    <group string="Observación">
                        <field name="observacion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_anio_escolar" model="ir.actions.act_window">
        <field name="name">Años escolares</field>
        <field name="res_model">anio.escolar</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>