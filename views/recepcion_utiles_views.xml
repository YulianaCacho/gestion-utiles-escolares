<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- VISTA LISTA DE RECEPCIONES -->
    <!-- ===================================================== -->

    <record id="view_recepcion_utiles_escolar_list" model="ir.ui.view">
        <field name="name">recepcion.utiles.escolar.list</field>
        <field name="model">recepcion.utiles.escolar</field>
        <field name="arch" type="xml">
            <list string="Recepciones de útiles">
                <field name="name" string="Código de recepción" />
                <field name="fecha" string="Fecha de recepción" />
                <field name="matricula_id" string="Matrícula" />
                <field name="estudiante_id" string="Estudiante" />
                <field name="grado_escolar" string="Grado escolar" />
                <field name="recibido_por_id" string="Recibido por" />
                <field name="items_resumen" string="Ítems" />
                <field name="estado_entrega" string="Estado de entrega" />
                <field name="estado_visual" string="Estado" />
            </list>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- FORMULARIO LIMPIO DE RECEPCIÓN DE ÚTILES -->
    <!-- ===================================================== -->

    <record id="view_recepcion_utiles_escolar_form_limpio_almacen" model="ir.ui.view">
        <field name="name">recepcion.utiles.escolar.form.limpio.almacen</field>
        <field name="model">recepcion.utiles.escolar</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Recepción de útiles" class="o_recepcion_clean_form">

                <header>

                    <button name="action_validar" string="Validar recepción" type="object" icon="fa-check" />

                    <button name="action_enviar_productos_almacen" string="Enviar a almacén" type="object" icon="fa-truck" class="btn-primary" invisible="estado != 'validado' or estado_almacen in ['enviado', 'sin_productos']" />

                    <field name="estado" widget="statusbar" statusbar_visible="borrador,incompleto,completo,validado" />

                </header>

                <sheet>

                    <field name="estado_almacen" invisible="1" />

                    <div class="o_recepcion_title_row">
                        <div class="o_recepcion_title_left">
                            <h1>
                                <field name="name" readonly="1" nolabel="1" />
                            </h1>
                        </div>
                        <div class="o_recepcion_title_badge">
                            <field name="estado" readonly="1" nolabel="1" widget="badge" />
                        </div>
                    </div>

                    <div class="o_recepcion_section_title">DATOS DE LA RECEPCIÓN</div>

                    <div class="o_recepcion_main_grid">

                        <div class="o_recepcion_left_panel">

                            <div class="o_recepcion_field_row">
                                <label for="fecha" string="Fecha de recepción" />
                                <field name="fecha" nolabel="1" />
                            </div>

                            <div class="o_recepcion_field_row">
                                <label for="anio" string="Año escolar" />
                                <field name="anio" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_field_row">
                                <label for="tipo_entrada" string="Tipo de entrada" />
                                <field name="tipo_entrada" nolabel="1" />
                            </div>

                            <div class="o_recepcion_field_row" invisible="tipo_entrada != 'recepcion_utiles'">
                                <label for="matricula_id" string="Matrícula" />
                                <field name="matricula_id" nolabel="1" options="{'no_create': True, 'no_open': False}" />
                            </div>

                            <div class="o_recepcion_field_row" invisible="tipo_entrada != 'recepcion_utiles'">
                                <label for="estudiante_id" string="Estudiante" />
                                <field name="estudiante_id" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_field_row" invisible="tipo_entrada != 'recepcion_utiles'">
                                <label for="grado_escolar" string="Grado escolar" />
                                <field name="grado_escolar" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_field_row" invisible="tipo_entrada != 'recepcion_utiles'">
                                <label for="lista_id" string="Lista de útiles" />
                                <field name="lista_id" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_field_row">
                                <label for="recibido_por_id" string="Recibido por" />
                                <field name="recibido_por_id" readonly="1" nolabel="1" />
                            </div>

                        </div>

                        <div class="o_recepcion_cards_grid" invisible="tipo_entrada != 'recepcion_utiles'">

                            <div class="o_recepcion_card">
                                <span class="o_form_label">TOTAL DE PRODUCTOS</span>
                                <field name="total_productos" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_card">
                                <span class="o_form_label">PRODUCTOS COMPLETOS</span>
                                <field name="total_completos" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_card">
                                <span class="o_form_label">PRODUCTOS FALTANTES</span>
                                <field name="total_faltantes" readonly="1" nolabel="1" />
                            </div>

                            <div class="o_recepcion_card o_recepcion_card_progress">

                                <span class="o_form_label">
                                    PORCENTAJE DE AVANCE
                                </span>

                                <div class="o_recepcion_percent">

                                    <field name="porcentaje_avance" readonly="1" nolabel="1" />

                                    <span>%</span>

                                </div>

                                <div class="o_recepcion_progress_widget">

                                    <field name="porcentaje_avance" widget="progressbar" readonly="1" nolabel="1" />

                                </div>

                            </div>

                            <div class="o_recepcion_card">
                                <span class="o_form_label">ESTADO DE ENTREGA</span>
                                <field name="estado_entrega" readonly="1" nolabel="1" widget="badge" />
                            </div>

                            <div class="o_recepcion_card">
                                <span class="o_form_label">ESTADO</span>
                                <field name="estado_visual" readonly="1" nolabel="1" widget="badge" />
                            </div>

                        </div>

                    </div>

                    <notebook>
                        <page string="Productos recibidos">
                            <field name="linea_ids" nolabel="1" context="{'default_destino_recepcion': 'almacen'}">
                                <list editable="bottom" create="tipo_entrada != 'recepcion_utiles'" delete="tipo_entrada != 'recepcion_utiles'" string="Productos recibidos">

                                    <field name="product_id" string="Producto" force_save="1" readonly="parent.tipo_entrada == 'recepcion_utiles'"/>
                                    <field name="categoria_id" string="Categoría" readonly="1" force_save="1"/>
                                    <field name="cantidad_esperada" string="Cantidad esperada" readonly="1" force_save="1"/>
                                    <field name="cantidad_entregada" string="Cantidad entregada" />
                                    <field name="cantidad_faltante" string="Cantidad faltante" readonly="1" force_save="1"/>
                                    <field name="unidad_id" string="Unidad" readonly="1" force_save="1"/>
                                    <field name="tipo_uso_escolar" string="Tipo de uso escolar" readonly="1" force_save="1"/>
                                    <field name="estado_linea" string="Estado" readonly="1" force_save="1" widget="badge" decoration-success="estado_linea == 'completo'" decoration-danger="estado_linea == 'faltante'" decoration-muted="estado_linea == 'pendiente'" />
                                    <field name="observacion" string="Observación" />

                                </list>
                            </field>
                        </page>

                        <page string="Observaciones">
                            <field name="observacion" nolabel="1" placeholder="Escribe una observación general de la recepción..." />
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- ACCIÓN NORMAL DE RECEPCIONES -->
    <!-- ===================================================== -->

    <record id="action_recepcion_utiles_almacen" model="ir.actions.act_window">
        <field name="name">Recepción de útiles</field>
        <field name="res_model">recepcion.utiles.escolar</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_recepcion_utiles_escolar_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_recepcion_utiles_escolar_form_limpio_almacen')})
        ]" />
    </record>

</odoo>