<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- VISTA LISTA DE RECEPCIONES -->
    <!-- ===================================================== -->

    <record id="view_recepcion_utiles_escolar_list" model="ir.ui.view">
        <field name="name">recepcion.utiles.escolar.list</field>
        <field name="model">recepcion.utiles.escolar</field>
        <field name="arch" type="xml">
            <list string="Recepciones de útiles">
                <field name="name" string="Código de recepción"/>
                <field name="fecha" string="Fecha de recepción"/>
                <field name="matricula_id" string="Matrícula"/>
                <field name="estudiante_id" string="Estudiante"/>
                <field name="grado_escolar" string="Grado escolar"/>
                <field name="recibido_por_id" string="Recibido por"/>
                <field name="items_resumen" string="Ítems"/>
                <field name="estado_entrega" string="Estado de entrega"/>
                <field name="estado_visual" string="Estado"/>
            </list>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- FORMULARIO LIMPIO DE RECEPCIÓN DE ÚTILES -->
    <!-- ===================================================== -->

    <record id="view_recepcion_utiles_escolar_form_limpio_almacen" model="ir.ui.view">
        <field name="name">recepcion.utiles.escolar.form.limpio.almacen</field>
        <field name="model">recepcion.utiles.escolar</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Recepción de útiles" class="o_recepcion_clean_form">

                <header>
                    <button name="action_cargar_lista"
                            string="Cargar lista de útiles"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_calcular_faltantes"
                            string="Calcular faltantes"
                            type="object"/>

                    <button name="action_validar"
                            string="Validar recepción"
                            type="object"
                            class="btn-primary"/>

                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="borrador,incompleto,completo,validado"/>
                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group string="DATOS DE LA RECEPCIÓN">
                        <group>
                            <field name="fecha" string="Fecha de recepción"/>
                            <field name="anio" string="Año escolar" readonly="1"/>

                            <field name="matricula_id"
                                   string="Matrícula"
                                   options="{'no_create': True, 'no_open': False}"/>

                            <field name="estudiante_id" string="Estudiante" readonly="1"/>
                            <field name="grado_escolar" string="Grado escolar" readonly="1"/>
                            <field name="lista_id" string="Lista de útiles" readonly="1"/>
                            <field name="recibido_por_id" string="Recibido por" readonly="1"/>
                        </group>

                        <group>
                            <field name="total_productos" string="Total de productos" readonly="1"/>
                            <field name="total_completos" string="Productos completos" readonly="1"/>
                            <field name="total_faltantes" string="Productos faltantes" readonly="1"/>
                            <field name="porcentaje_avance" string="Porcentaje de avance" readonly="1"/>
                            <field name="estado_entrega" string="Estado de entrega" readonly="1"/>
                            <field name="estado_visual" string="Estado" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos recibidos">
                            <field name="linea_ids" nolabel="1">
                                <list editable="bottom"
                                      create="0"
                                      delete="0"
                                      string="Productos recibidos">

                                    <field name="product_id"
                                           string="Producto"
                                           readonly="1"/>

                                    <field name="categoria_id"
                                           string="Categoría"
                                           readonly="1"/>

                                    <field name="cantidad_esperada"
                                           string="Cantidad esperada"
                                           readonly="1"/>

                                    <field name="cantidad_entregada"
                                           string="Cantidad entregada"/>

                                    <field name="cantidad_faltante"
                                           string="Cantidad faltante"
                                           readonly="1"/>

                                    <field name="unidad_id"
                                           string="Unidad"
                                           readonly="1"/>

                                    <field name="tipo_uso_escolar"
                                           string="Tipo de uso escolar"
                                           readonly="1"/>

                                    <field name="estado_linea"
                                           string="Estado"
                                           readonly="1"/>

                                    <field name="observacion"
                                           string="Observación"/>
                                </list>
                            </field>
                        </page>

                        <page string="Observaciones">
                            <field name="observacion"
                                   nolabel="1"
                                   placeholder="Escribe una observación general de la recepción..."/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- ACCIÓN NORMAL DE RECEPCIONES -->
    <!-- ===================================================== -->

    <record id="action_recepcion_utiles_almacen" model="ir.actions.act_window">
        <field name="name">Recepción</field>
        <field name="res_model">recepcion.utiles.escolar</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>