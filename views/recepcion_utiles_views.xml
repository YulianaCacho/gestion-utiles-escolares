<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- MENÚ PRINCIPAL REPORTES -->
    <!-- ========================= -->

    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="name">Reportes</field>
        <field name="active" eval="True"/>
    </record>


    <!-- ========================= -->
    <!-- OCULTAR REPORTES NATIVOS -->
    <!-- ========================= -->

    <function model="ir.ui.menu" name="write">
        <function model="ir.ui.menu" name="search">
            <value eval="[
                ('parent_id', '=', ref('stock.menu_warehouse_report')),
                ('name', 'in', [
                    'Existencias',
                    'Ubicaciones',
                    'Historial de movimientos',
                    'Análisis de movimientos',
                    'Stock',
                    'Locations',
                    'Moves History',
                    'Moves Analysis',
                    'Move Analysis'
                ])
            ]"/>
        </function>
        <value eval="{'active': False}"/>
    </function>


    <!-- ========================= -->
    <!-- ACCIONES PERSONALIZADAS -->
    <!-- ========================= -->

    <record id="action_reporte_linea_tiempo_utiles" model="ir.actions.act_window">
        <field name="name">⇅Línea de tiempo</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_reporte_historial_movimientos_utiles" model="ir.actions.act_window">
        <field name="name">⧗Historial de movimientos</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_reporte_recepcion_utiles_menu" model="ir.actions.act_window">
        <field name="name">▦Reporte de recepción</field>
        <field name="res_model">recepcion.utiles</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>


    <!-- ========================= -->
    <!-- MENÚS PERSONALIZADOS -->
    <!-- ========================= -->

    <record id="menu_reporte_linea_tiempo_utiles" model="ir.ui.menu">
        <field name="name">⇅Línea de tiempo</field>
        <field name="parent_id" ref="stock.menu_warehouse_report"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_reporte_linea_tiempo_utiles')"/>
        <field name="sequence">10</field>
        <field name="active" eval="True"/>
    </record>

    <record id="menu_reporte_historial_movimientos_utiles" model="ir.ui.menu">
        <field name="name">⧗Historial de movimientos</field>
        <field name="parent_id" ref="stock.menu_warehouse_report"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_reporte_historial_movimientos_utiles')"/>
        <field name="sequence">20</field>
        <field name="active" eval="True"/>
    </record>

    <record id="menu_reporte_recepcion_utiles" model="ir.ui.menu">
        <field name="name">▦Reporte de recepción</field>
        <field name="parent_id" ref="stock.menu_warehouse_report"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_reporte_recepcion_utiles_menu')"/>
        <field name="sequence">30</field>
        <field name="active" eval="True"/>
    </record>

</odoo>