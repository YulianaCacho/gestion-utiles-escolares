<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_salida_utiles_list" model="ir.ui.view">
        <field name="name">salida.utiles.list</field>
        <field name="model">salida.utiles</field>
        <field name="arch" type="xml">
            <list string="Salidas de útiles">
                <field name="name"/>
                <field name="fecha_salida"/>
                <field name="responsable_id"/>
                <field name="miss_id"/>
                <field name="grado_escolar"/>
                <field name="total_productos"/>
                <field name="total_cantidad"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_salida_utiles_form" model="ir.ui.view">
        <field name="name">salida.utiles.form</field>
        <field name="model">salida.utiles</field>
        <field name="arch" type="xml">
            <form string="Salida de útiles">
                <header>
                    <button name="action_validar"
                            string="Validar salida"
                            type="object"
                            class="btn-primary"
                            invisible="estado == 'validado'"/>

                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="borrador,validado"/>
                </header>

                <sheet>
                    <group>
                        <group string="Datos de la salida">
                            <field name="name"/>
                            <field name="fecha_salida"/>
                            <field name="responsable_id"/>
                            <field name="user_id"/>
                        </group>

                        <group string="Entrega">
                            <field name="miss_id"/>
                            <field name="grado_escolar"/>
                            <field name="total_productos"/>
                            <field name="total_cantidad"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos retirados">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="cantidad"/>
                                    <field name="uom_id"/>
                                    <field name="observacion"/>
                                </list>
                            </field>
                        </page>

                        <page string="Observación">
                            <field name="observacion"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_salida_utiles" model="ir.actions.act_window">
        <field name="name">Salidas de útiles</field>
        <field name="res_model">salida.utiles</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- OJO: si tu menú principal tiene otro ID, cambia menu_utiles_escolares_root -->
    <menuitem id="menu_salida_utiles"
              name="Salidas de útiles"
              parent="menu_utiles_escolares_root"
              action="action_salida_utiles"
              sequence="40"
              groups="gestion_utiles_escolares.group_salidas_utiles"/>

</odoo>