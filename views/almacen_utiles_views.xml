<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_almacen_utiles_movimiento_list" model="ir.ui.view">
        <field name="name">almacen.utiles.movimiento.list</field>
        <field name="model">almacen.utiles.movimiento</field>
        <field name="arch" type="xml">
            <list string="Historial de movimientos" create="0" edit="0" delete="0">
                <field name="fecha"/>
                <field name="anio_escolar_id"/>
                <field name="tipo_movimiento"/>
                <field name="motivo_movimiento" string="Motivo"/>
                <field name="grado_escolar" string="Grado / sección"/>
                <field name="product_id"/>
                <field name="cantidad"/>
                <field name="unidad_id"/>
                <field name="destino"/>
                <field name="responsable_id"/>
                <field name="anio_origen_id" string="Año origen" optional="hide"/>
                <field name="anio_destino_id" string="Año destino" optional="hide"/>
                <field name="recepcion_id" optional="hide"/>
                <field name="estudiante_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_recepcion_utiles_almacen_dashboard" model="ir.actions.client">
        <field name="name">↧ Recepción</field>
        <field name="tag">gestion_utiles_escolares.recepcion_almacen_dashboard</field>
    </record>

    <menuitem id="menu_almacen_utiles_root" name="📦 Almacén de útiles" parent="stock.menu_stock_root" sequence="95"/>

    <menuitem id="menu_recepcion_almacen_utiles" name=" Recepción" parent="menu_almacen_utiles_root" action="action_recepcion_utiles_almacen_dashboard" sequence="10"/>

    <menuitem id="menu_almacen_utiles_movimiento"
            name="⧗ Historial de movimientos"
            parent="menu_almacen_utiles_root"
            action="action_almacen_utiles_movimiento"
            sequence="30"/>

</odoo>