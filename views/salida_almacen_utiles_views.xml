<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_salida_almacen_utiles_list" model="ir.ui.view">
        <field name="name">salida.almacen.utiles.list</field>
        <field name="model">salida.almacen.utiles</field>
        <field name="arch" type="xml">
            <list string="Entregas de almacén">
                <field name="name"/>
                <field name="fecha_salida"/>
                <field name="responsable_id"/>
                <field name="miss_id"/>
                <field name="grado_escolar"/>
                <field name="total_productos"/>
                <field name="total_cantidad"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_salida_almacen_utiles_form" model="ir.ui.view">
        <field name="name">salida.almacen.utiles.form</field>
        <field name="model">salida.almacen.utiles</field>
        <field name="arch" type="xml">
            <form string="Entrega de almacén">
                <header>
                    <button name="action_validar_salida"
                            type="object"
                            string="Validar entrega"
                            class="btn-primary"
                            invisible="estado == 'validado'"/>

                    <field name="estado"
                           widget="statusbar"
                           statusbar_visible="borrador,validado"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="Datos de la entrega">
                        <group>
                            <field name="fecha_salida"/>
                            <field name="responsable_id"/>
                            <field name="user_id"/>
                        </group>

                        <group>
                            <field name="miss_id"/>
                            <field name="grado_escolar"/>
                            <field name="total_productos"/>
                            <field name="total_cantidad"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Productos entregados">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="categoria_id"/>
                                    <field name="stock_disponible"/>
                                    <field name="cantidad"/>
                                    <field name="unidad_id"/>
                                    <field name="observacion"/>
                                </list>
                            </field>
                        </page>

                        <page string="Observación">
                            <field name="observacion"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salida_almacen_utiles_search" model="ir.ui.view">
        <field name="name">salida.almacen.utiles.search</field>
        <field name="model">salida.almacen.utiles</field>
        <field name="arch" type="xml">
            <search string="Buscar entregas de almacén">
                <field name="name"/>
                <field name="responsable_id"/>
                <field name="miss_id"/>
                <field name="grado_escolar"/>
                <field name="estado"/>

                <filter name="filtro_borrador"
                        string="Borrador"
                        domain="[('estado','=','borrador')]"/>

                <filter name="filtro_validado"
                        string="Validado"
                        domain="[('estado','=','validado')]"/>

                <separator/>

                <filter name="grupo_grado"
                        string="Agrupar por grado"
                        context="{'group_by':'grado_escolar'}"/>

                <filter name="grupo_miss"
                        string="Agrupar por miss"
                        context="{'group_by':'miss_id'}"/>

                <filter name="grupo_responsable"
                        string="Agrupar por responsable"
                        context="{'group_by':'responsable_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_salida_almacen_utiles" model="ir.actions.act_window">
        <field name="name">Entregas</field>
        <field name="res_model">salida.almacen.utiles</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_salida_almacen_utiles_search"/>
    </record>

    <menuitem id="menu_salida_almacen_utiles"
              name="↥ Entregas"
              parent="menu_almacen_utiles_root"
              action="action_salida_almacen_utiles"
              sequence="20"/>

</odoo>