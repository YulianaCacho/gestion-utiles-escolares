<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_template_ia_list" model="ir.ui.view">
        <field name="name">product.template.ia.class.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Clases IA de productos" editable="bottom">
                <field name="default_code" string="Código"/>
                <field name="name" string="Producto"/>
                <field name="ia_clase_util" string="Clase IA"/>
                <field name="categ_id" string="Categoría"/>
                <field name="uom_id" string="Unidad"/>
            </list>
        </field>
    </record>

    <record id="action_product_template_ia_clases" model="ir.actions.act_window">
        <field name="name">Clases IA de productos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_template_ia_list"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="menu_product_template_ia_clases" model="ir.ui.menu">
        <field name="name">Clases IA de productos</field>
        <field name="parent_id" ref="stock.menu_stock_root"/>
        <field name="action" ref="action_product_template_ia_clases"/>
        <field name="sequence">8</field>
        <field name="active" eval="False"/>
    </record>

</odoo>