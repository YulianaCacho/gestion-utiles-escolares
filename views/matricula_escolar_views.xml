<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- VISTA: LISTA DE MATRÍCULAS -->
    <!-- Esta vista se usa para "Lista de matrícula" -->
    <!-- ========================= -->
    <record id="view_matricula_escolar_list" model="ir.ui.view">
        <field name="name">matricula.escolar.list</field>
        <field name="model">matricula.escolar</field>
        <field name="arch" type="xml">
            <list string="Lista de matrícula">
                <field name="estudiante_id" string="Estudiante" />
                <field name="grado_escolar" string="Grado escolar" />
                <field name="apoderado_principal_id" string="Apoderado principal" />
                <field name="estado" string="Estado del estudiante" widget="badge" decoration-success="estado == 'activo'" decoration-danger="estado == 'retirado'" decoration-muted="estado == 'finalizado'" />
            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- VISTA: ESTADO POR ALUMNO -->
    <!-- Esta vista es SOLO para el apartado "Estado por alumno" -->
    <!-- ========================= -->
    <record id="view_matricula_estado_alumno_list" model="ir.ui.view">
        <field name="name">matricula.escolar.estado.alumno.list</field>
        <field name="model">matricula.escolar</field>
        <field name="arch" type="xml">
            <list string="Estado por alumno">
                <field name="estudiante_id" string="Estudiante" />
                <field name="grado_escolar" string="Grado escolar" />
                <field name="estado" string="Estado del estudiante" widget="badge" decoration-success="estado == 'activo'" decoration-danger="estado == 'retirado'" decoration-muted="estado == 'finalizado'" />
                <field name="situacion_siguiente_anio" string="Situación para el siguiente año" />
                <field name="apoderado_principal_id" string="Apoderado principal" />
            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- VISTA: FORMULARIO DE MATRÍCULA MEJORADO -->
    <!-- ========================= -->
    <record id="view_matricula_escolar_form" model="ir.ui.view">
        <field name="name">matricula.escolar.form.clean</field>
        <field name="model">matricula.escolar</field>
        <field name="arch" type="xml">
            <form string="Matrícula escolar" class="o_ge_matricula_form_view">
                <sheet>
                    <field name="anio_escolar" invisible="1" />

                    <div class="o_ge_matricula_page">

                        <!-- DATOS DE MATRÍCULA -->
                        <div class="o_ge_matricula_card">
                            <div class="o_ge_card_header">
                                <span class="o_ge_card_icon">
                                    <i class="fa fa-id-card-o" title="Datos de matrícula" />
                                </span>
                                <span>DATOS DE MATRÍCULA</span>
                            </div>

                            <div class="o_ge_card_body">

                                <div class="o_ge_field_block o_ge_full">
                                    <label for="estudiante_id" />
                                    <field name="estudiante_id" nolabel="1" placeholder="Seleccionar estudiante o crear nuevo" context="{'default_tipo_contacto_escolar': 'estudiante'}" options="{'no_create': False, 'no_open': False}" />
                                </div>

                                <div class="o_ge_two_cols">
                                    <div class="o_ge_field_block">
                                        <label for="anio_escolar_id" />
                                        <field name="anio_escolar_id" nolabel="1" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True}" />
                                    </div>

                                    <div class="o_ge_field_block">
                                        <label for="grado_escolar" />
                                        <field name="grado_escolar" nolabel="1" placeholder="Sin asignar" />
                                    </div>
                                </div>

                                <div class="o_ge_two_cols">
                                    <div class="o_ge_field_block">
                                        <label for="lista_utiles_id" />
                                        <field name="lista_utiles_id" nolabel="1"
                                                placeholder="Se asigna automáticamente según el grado"
                                                readonly="1"
                                                force_save="1"
                                                options="{'no_create': True, 'no_open': True}" />
                                    </div>

                                    <div class="o_ge_field_block">
                                        <label for="estado" />
                                        <field name="estado" nolabel="1"
                                            placeholder="Seleccionar estado"
                                            options="{'no_create': True}" />
                                        </div>
                                </div>

                                <field name="situacion_siguiente_anio" invisible="1" />
                                <field name="matricula_anterior_id" invisible="1" />
                                <field name="matricula_siguiente_id" invisible="1" />

                            </div>
                        </div>

                        <!-- RELACIÓN FAMILIAR -->
                        <div class="o_ge_matricula_card">
                            <div class="o_ge_card_header">
                                <span class="o_ge_card_icon">
                                    <i class="fa fa-users" title="Relación familiar" />
                                </span>
                                <span>RELACIÓN FAMILIAR</span>
                            </div>

                            <div class="o_ge_card_body">
                                <div class="o_ge_two_cols">
                                    <div class="o_ge_field_block">
                                        <label for="apoderado_principal_id" />
                                        <field name="apoderado_principal_id" nolabel="1"
                                            placeholder="Seleccionar o crear apoderado principal"
                                            domain="['|', ('tipo_contacto_escolar', '=', 'apoderado'), ('tipo_contacto_escolar', '=', False)]"
                                            context="{'default_tipo_contacto_escolar': 'apoderado'}"
                                            options="{'no_create': False, 'no_open': False}" />
                                    </div>

                                    <div class="o_ge_field_block">
                                        <label for="apoderado_secundario_id" />
                                        <field name="apoderado_secundario_id" nolabel="1"
                                            placeholder="Seleccionar o crear apoderado secundario"
                                            domain="['|', ('tipo_contacto_escolar', '=', 'apoderado'), ('tipo_contacto_escolar', '=', False)]"
                                            context="{'default_tipo_contacto_escolar': 'apoderado'}"
                                            options="{'no_create': False, 'no_open': False}" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- OBSERVACIÓN -->
                        <div class="o_ge_matricula_card">
                            <div class="o_ge_card_header">
                                <span class="o_ge_card_icon">
                                    <i class="fa fa-sticky-note-o" title="Observación" />
                                </span>
                                <span>OBSERVACIÓN</span>
                            </div>

                            <div class="o_ge_card_body">
                                <div class="o_ge_field_block o_ge_full">
                                    <label for="observacion" />
                                    <field name="observacion" nolabel="1" placeholder="Sin observaciones" />
                                </div>
                            </div>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================= -->
    <!-- ACCIÓN: REGISTRAR MATRÍCULA -->
    <!-- ========================= -->
    <record id="action_registrar_matricula" model="ir.actions.act_window">
        <field name="name">Registrar matrícula</field>
        <field name="res_model">matricula.escolar</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="view_matricula_escolar_form" />
        <field name="context">{'default_estado': 'activo'}</field>
    </record>


    <!-- ========================= -->
    <!-- ACCIÓN: LISTA DE MATRÍCULA -->
    <!-- Usa la vista simple -->
    <!-- ========================= -->
    <record id="action_lista_matricula" model="ir.actions.act_window">
        <field name="name">Lista de matrícula</field>
        <field name="res_model">matricula.escolar</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_matricula_escolar_list" />
        <field name="domain">[('es_anio_actual', '=', True)]</field>
    </record>


    <!-- ========================= -->
    <!-- ACCIÓN: ESTADO POR ALUMNO -->
    <!-- Usa la vista con estado y situación -->
    <!-- ========================= -->
    <record id="action_estado_por_alumno" model="ir.actions.act_window">
        <field name="name">Estado por alumno</field>
        <field name="res_model">matricula.escolar</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_matricula_estado_alumno_list" />
        <field name="domain">[('es_anio_actual', '=', True)]</field>
    </record>


    <!-- ========================= -->
    <!-- REORDENAR MENÚ PRINCIPAL MATRÍCULAS -->
    <!-- ========================= -->
    <record id="menu_utiles_escolares_root" model="ir.ui.menu">
        <field name="name">🎓 Matrículas</field>
        <field name="parent_id" ref="stock.menu_stock_root" />
        <field name="sequence">30</field>
    </record>


    <!-- ========================= -->
    <!-- MENÚ: REGISTRAR MATRÍCULA -->
    <!-- ========================= -->
    <menuitem id="menu_registrar_matricula" name="✚ Registrar matrícula" parent="menu_utiles_escolares_root" action="action_registrar_matricula" sequence="10" />

    <record id="menu_registrar_matricula" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ========================= -->
    <!-- ACCIÓN: DASHBOARD MODERNO DE MATRÍCULA -->
    <!-- ========================= -->
    <record id="action_matricula_dashboard_client" model="ir.actions.client">
        <field name="name">Lista de matrícula</field>
        <field name="tag">matricula_dashboard</field>
    </record>


    <!-- ========================= -->
    <!-- MENÚ: LISTA DE MATRÍCULA -->
    <!-- Pantalla principal del módulo de matrículas -->
    <!-- ========================= -->
    <menuitem id="menu_lista_matricula" name="▤ Lista de matrícula" parent="menu_utiles_escolares_root" action="action_matricula_dashboard_client" sequence="10" />

    <!-- ========================= -->
    <!-- MENÚ: ESTADO POR ALUMNO -->
    <!-- ========================= -->

    <!-- Acción cliente moderna para Estado por alumno -->
    <record id="action_estado_alumno_dashboard" model="ir.actions.client">
        <field name="name">Estado por alumno</field>
        <field name="tag">estado_alumno_dashboard</field>
    </record>

    <!-- ========================= -->
    <!-- MENÚ: ESTADO POR ALUMNO -->
    <!-- Oculto porque el estado ahora se mostrará dentro de Lista de matrícula -->
    <!-- ========================= -->
    <menuitem id="menu_estado_por_alumno" name="⊙ Estado por alumno" parent="menu_utiles_escolares_root" action="action_estado_alumno_dashboard" sequence="40" />

    <record id="menu_estado_por_alumno" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>