<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- VISTA: LISTA DE MATRÍCULAS -->
    <!-- Esta vista se usa para "Lista de matrícula" -->
    <!-- ========================= -->
    <record id="view_matricula_escolar_list" model="ir.ui.view">
        <field name="name">matricula.escolar.list</field>
        <field name="model">matricula.escolar</field>
        <field name="arch" type="xml">
            <list string="Lista de matrícula">
                <field name="estudiante_id" string="Estudiante"/>
                <field name="grado_escolar" string="Grado escolar"/>
                <field name="apoderado_principal_id" string="Apoderado principal"/>
            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- VISTA: ESTADO POR ALUMNO -->
    <!-- Esta vista es SOLO para el apartado "Estado por alumno" -->
    <!-- ========================= -->
    <record id="view_matricula_estado_alumno_list" model="ir.ui.view">
        <field name="name">matricula.escolar.estado.alumno.list</field>
        <field name="model">matricula.escolar</field>
        <field name="arch" type="xml">
            <list string="Estado por alumno">
                <field name="estudiante_id" string="Estudiante"/>
                <field name="grado_escolar" string="Grado escolar"/>
                <field name="estado" string="Estado del estudiante" widget="badge"/>
                <field name="situacion_siguiente_anio" string="Situación para el siguiente año"/>
                <field name="apoderado_principal_id" string="Apoderado principal"/>
            </list>
        </field>
    </record>


    <!-- ========================= -->
    <!-- VISTA: FORMULARIO DE MATRÍCULA -->
    <!-- ========================= -->
    <record id="view_matricula_escolar_form" model="ir.ui.view">
        <field name="name">matricula.escolar.form</field>
        <field name="model">matricula.escolar</field>
        <field name="arch" type="xml">
            <form string="Matrícula escolar">
                <sheet>

                    <group string="Datos de matrícula">
                        <field name="estudiante_id"/>

                        <field name="anio_escolar_id"
                                readonly="1"
                                force_save="1"
                                options="{'no_open': True, 'no_create': True}"/>

                        <field name="grado_escolar"/>
                        <field name="anio_escolar" invisible="1"/>
                        <field name="lista_utiles_id"/>
                        <field name="estado"/>
                        <field name="situacion_siguiente_anio"/>
                        <field name="matricula_anterior_id" readonly="1"/>
                        <field name="matricula_siguiente_id" readonly="1"/>
                    </group>

                    <group string="Relación familiar">
                        <field name="apoderado_principal_id"/>
                        <field name="apoderado_secundario_id"/>
                    </group>

                    <group string="Observación">
                        <field name="observacion"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ========================= -->
    <!-- ACCIÓN: REGISTRAR MATRÍCULA -->
    <!-- ========================= -->
    <record id="action_registrar_matricula" model="ir.actions.act_window">
        <field name="name">Registrar matrícula</field>
        <field name="res_model">matricula.escolar</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="view_matricula_escolar_form"/>
        <field name="context">{'default_estado': 'activo'}</field>
    </record>


    <!-- ========================= -->
    <!-- ACCIÓN: LISTA DE MATRÍCULA -->
    <!-- Usa la vista simple -->
    <!-- ========================= -->
    <record id="action_lista_matricula" model="ir.actions.act_window">
        <field name="name">Lista de matrícula</field>
        <field name="res_model">matricula.escolar</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_matricula_escolar_list"/>
        <field name="domain">[('es_anio_actual', '=', True)]</field>
    </record>


    <!-- ========================= -->
    <!-- ACCIÓN: ESTADO POR ALUMNO -->
    <!-- Usa la vista con estado y situación -->
    <!-- ========================= -->
    <record id="action_estado_por_alumno" model="ir.actions.act_window">
        <field name="name">Estado por alumno</field>
        <field name="res_model">matricula.escolar</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_matricula_estado_alumno_list"/>
        <field name="domain">[('es_anio_actual', '=', True)]</field>
    </record>


    <!-- ========================= -->
    <!-- REORDENAR MENÚ PRINCIPAL MATRÍCULAS -->
    <!-- ========================= -->
    <record id="menu_utiles_escolares_root" model="ir.ui.menu">
        <field name="sequence">30</field>
    </record>


    <!-- ========================= -->
    <!-- MENÚ: REGISTRAR MATRÍCULA -->
    <!-- ========================= -->
    <menuitem id="menu_registrar_matricula"
                name="✚ Registrar matrícula"
                parent="menu_utiles_escolares_root"
                action="action_registrar_matricula"
                sequence="10"/>


    <!-- ========================= -->
    <!-- MENÚ: LISTA DE MATRÍCULA -->
    <!-- ========================= -->
    <menuitem id="menu_lista_matricula"
                name="▤ Lista de matrícula"
                parent="menu_utiles_escolares_root"
                action="action_lista_matricula"
                sequence="20"/>


    <!-- ========================= -->
    <!-- MENÚ: ESTADO POR ALUMNO -->
    <!-- ========================= -->
    <menuitem id="menu_estado_por_alumno"
                name="⊙ Estado por alumno"
                parent="menu_utiles_escolares_root"
                action="action_estado_por_alumno"
                sequence="40"/>

</odoo>