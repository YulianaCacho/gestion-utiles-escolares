<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_cierre_anio_matriculas_list" model="ir.ui.view">
        <field name="name">cierre.anio.matriculas.list</field>
        <field name="model">cierre.anio.matriculas</field>
        <field name="arch" type="xml">
            <list string="Revisiones de promoción">
                <field name="name" />
                <field name="anio_origen_id" />
                <field
                    name="anio_destino_id"
                    string="Año siguiente"
                    readonly="1"
                    placeholder="Se asignará al crear el siguiente año"
                />
                <field name="fecha_revision" />
                <field name="responsable_id" />
                <field name="total_alumnos" />
                <field name="total_promovidos" />
                <field name="total_repiten" />
                <field name="total_retirados" />
                <field name="estado" />
            </list>
        </field>
    </record>

    <record id="view_cierre_anio_matriculas_form" model="ir.ui.view">
        <field name="name">cierre.anio.matriculas.form</field>
        <field name="model">cierre.anio.matriculas</field>
        <field name="arch" type="xml">
            <form string="Revisión de promoción de alumnos">
                <header>
                    <button
                        name="action_generar_revision"
                        string="Generar lista de alumnos"
                        type="object"
                        class="btn-secondary"
                        invisible="estado != 'borrador'"
                        confirm="Se cargarán las matrículas activas del año. ¿Deseas continuar?"
                    />

                    <button name="action_confirmar_revision"
                        string="Validar resultados"
                        type="object"
                        class="btn-primary"
                        invisible="estado != 'revision'"
                        confirm=" Se guardará la situación final de cada estudiante y las matrículas del año pasarán a estado Finalizado. ¿Deseas validar los resultados?"/>

                    <field name="estado"
                        widget="statusbar"
                        statusbar_visible="borrador,revision,confirmado" />
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <group string="Datos de la revisión">
                        <group>
                            <field name="anio_origen_id" />
                            <field name="anio_destino_id" />
                            <field name="fecha_revision" />
                            <field name="fecha_confirmacion" />
                        </group>
                        <group>
                            <field name="responsable_id" />
                            <field name="total_alumnos" />
                            <field name="total_promovidos" />
                            <field name="total_repiten" />
                            <field name="total_retirados" />
                        </group>
                    </group>

                    <group string="Observación general">
                        <field name="observacion"
                                readonly="estado == 'confirmado'"
                                placeholder="Ejemplo: Revisión de promoción realizada con el reporte de notas del año."
                        />
                    </group>

                    <notebook>
                        <page string="Alumnos revisados">
                            <field
                                name="linea_ids"
                                nolabel="1"
                                readonly="estado == 'confirmado'"
                            >

                                <list editable="bottom"
                                    create="0"
                                    delete="0"
                                    string="Alumnos">
                                    <field name="grado_escolar" />
                                    <field name="estudiante_id" />
                                    <field name="situacion_revisada" />
                                    <field name="grado_siguiente_label" />
                                    <field name="observacion" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cierre_anio_matriculas" model="ir.actions.act_window">
        <field name="name">Revisiones de promoción</field>
        <field name="res_model">cierre.anio.matriculas</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cierre_anio_matriculas"
        name="🎓 Revisión de promoción"
        parent="menu_utiles_escolares_root"
        action="action_cierre_anio_matriculas"
        sequence="50" />

    <record id="menu_cierre_anio_matriculas" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>