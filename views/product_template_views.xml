<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista formulario de productos -->
    <record id="view_product_template_form_gestion_utiles_escolares" model="ir.ui.view">
        <field name="name">product.template.form.gestion.utiles.escolares</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Reemplazar responsable individual por responsables múltiples y ubicación escolar -->
            <xpath expr="//field[@name='responsible_id']" position="replace">
                 <field name="responsable_escolar_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"/>
            </xpath>

            <!-- Mostrar Tipo de uso escolar debajo de Referencia interna -->
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="tipo_uso_escolar"/>
            </xpath>

            <!-- OCULTAR CAMPOS QUE NO USAREMOS EN INFORMACIÓN GENERAL -->

            <!-- Ocultar checkbox de Ventas -->
            <xpath expr="//field[@name='sale_ok']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ocultar bloque completo de precio de venta -->
            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='list_price']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ocultar bloque completo de costo -->
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='standard_price']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ocultar código de barras -->
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- OCULTAR CAMPOS QUE NO USAREMOS EN INVENTARIO -->

            <!-- Ocultar peso completo -->
            <xpath expr="//label[@for='weight']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='weight']/ancestor::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ocultar volumen completo -->
            <xpath expr="//label[@for='volume']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='volume']/ancestor::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ocultar plazo completo -->
            <xpath expr="//label[@for='sale_delay']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='sale_delay']/ancestor::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Ocultar ubicación de producción -->
            <xpath expr="//field[@name='property_stock_production']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Reemplazar ubicación de inventario estándar por ubicación física escolar -->
            <xpath expr="//field[@name='property_stock_inventory']" position="replace">
                <field name="ubicacion_fisica_id"
                       options="{'no_create': True}"
                       placeholder="Ejemplo: A-N1"/>

                <field name="codigo_ubicacion_fisica"
                       readonly="1"/>
            </xpath>

            <!-- Ocultar todo el bloque: Descripción para recepciones -->
            <xpath expr="//field[@name='description_pickingin']/.." position="replace"/>

            <!-- Ocultar todo el bloque: Descripción para órdenes de entrega -->
            <xpath expr="//field[@name='description_pickingout']/.." position="replace"/>

        </field>
    </record>

    <!-- Vista kanban de productos -->
    <record id="view_product_template_kanban_gestion_utiles_escolares" model="ir.ui.view">
        <field name="name">product.template.kanban.gestion.utiles.escolares</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">

            <!-- Ocultar precio en las tarjetas de productos -->
            <xpath expr="//field[@name='list_price']/.." position="replace"/>

        </field>
    </record>

    <!-- Vista lista de productos -->
    <record id="view_product_template_list_gestion_utiles_escolares" model="ir.ui.view">
        <field name="name">product.template.list.gestion.utiles.escolares</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <!-- Ocultar precio de venta -->
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- Ocultar costo -->
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- Ocultar stock pronosticado -->
            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- Mostrar categoría después de referencia interna -->
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="categ_id" optional="show"/>
            </xpath>

            <!-- Mostrar tipo de uso escolar después de unidad -->
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="tipo_uso_escolar" optional="show"/>
            </xpath>

        </field>
    </record>

       <!-- ========================= -->
    <!-- OCULTAR MENÚ NATIVO PRODUCTOS DE ODOO -->
    <!-- ========================= -->

    <record id="stock.menu_stock_inventory_control" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>


    <!-- ========================= -->
    <!-- MENÚ PERSONALIZADO PRODUCTOS ESCOLARES -->
    <!-- ========================= -->

    <!-- Menú principal personalizado en la barra verde -->
    <record id="menu_productos_escolares_root" model="ir.ui.menu">
        <field name="name">📚 Productos</field>
        <field name="parent_id" ref="stock.menu_stock_root"/>
        <field name="sequence">40</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Vista kanban de productos escolares -->
    <record id="view_product_template_kanban_utiles_escolares" model="ir.ui.view">
        <field name="name">product.template.kanban.utiles.escolares</field>
        <field name="model">product.template</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="default_code"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="tipo_uso_escolar"/>
                <field name="image_128"/>

                <templates>
                   <t t-name="kanban-box">
                       <div class="oe_kanban_card oe_kanban_global_click" style="border-radius: 14px; padding: 14px; min-height: 150px;">
                          <div style="display: flex; gap: 12px; align-items: center;">
                              <div>
                                  <img t-att-src="kanban_image('product.template', 'image_128', record.id.raw_value)"
                                     style="width: 54px; height: 54px; object-fit: cover; border-radius: 10px; border: 1px solid #ddd;"/>
                               </div>

                               <div style="flex: 1;">
                                    <strong style="font-size: 16px;">
                                          <field name="name"/>
                                    </strong>

                                    <div style="font-size: 13px; color: #666; margin-top: 4px;">
                                        Ref:
                                        <t t-if="record.default_code.raw_value">
                                            <field name="default_code"/>
                                        </t>
                                        <t t-else="">Sin referencia</t>
                                    </div>
                                </div>
                            </div>

                            <div style="margin-top: 14px; display: flex; justify-content: space-between;">
                                <div>
                                    <div style="font-size: 12px; color: #777;">A la mano</div>
                                    <strong>
                                         <field name="qty_available"/>
                                    </strong>
                                    <span>
                                       <field name="uom_id"/>
                                    </span>
                               </div>

                               <div style="text-align: right;">
                                  <div style="font-size: 12px; color: #777;">Tipo de uso</div>
                                  <span style="background: #e8f5dd; color: #3f7f18; padding: 4px 8px; border-radius: 999px; font-size: 12px;">
                                      <field name="tipo_uso_escolar"/>
                                  </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción: Útiles escolares -->
    <record id="action_productos_utiles_escolares" model="ir.actions.act_window">
        <field name="name">Útiles escolares</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_product_template_kanban_utiles_escolares"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Acción: Categorías -->
    <record id="action_categorias_utiles_escolares" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Submenú: Útiles escolares -->
    <record id="menu_productos_utiles_escolares" model="ir.ui.menu">
        <field name="name">✎ Útiles escolares</field>
        <field name="parent_id" ref="menu_productos_escolares_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_productos_utiles_escolares')"/>
        <field name="sequence">10</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Submenú: Categorías -->
    <record id="menu_categorias_utiles_escolares" model="ir.ui.menu">
        <field name="name">≡ Categorías</field>
        <field name="parent_id" ref="menu_productos_escolares_root"/>
        <field name="action" eval="'ir.actions.act_window,%d' % ref('action_categorias_utiles_escolares')"/>
        <field name="sequence">20</field>
        <field name="active" eval="True"/>
    </record>
    
</odoo>
